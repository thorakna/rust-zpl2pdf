# zpl2pdf-server settings. Copy to .env and adjust:
#   cp example.env .env
#   docker run --rm -p 8080:8080 --env-file .env zpl2pdf
# The server reads these from the process environment; command line flags
# (--listen, --auth-token, ...) override them. Keep comments on their own
# lines and values unquoted so the file also works with `docker --env-file`.

# Token for the conversion routes (/v1/printers/..., /v1/convert). When set,
# requests must send `Authorization: Bearer <token>`. Leave empty to disable
# the check. /health is always open.
ZPL2PDF_AUTH_TOKEN=

# Address to listen on.
ZPL2PDF_LISTEN=0.0.0.0:8080

# Maximum request body size in bytes (8 MiB).
ZPL2PDF_MAX_BODY=8388608

# Maximum number of labels per request.
ZPL2PDF_MAX_LABELS=200

# Maximum decoded size of one graphic in bytes (8 MiB).
ZPL2PDF_MAX_GRAPHIC=8388608

# Conversions running at the same time. Defaults to the CPU count.
# ZPL2PDF_CONCURRENCY=4

# Request timeout in seconds.
ZPL2PDF_TIMEOUT=30

# Log filter.
RUST_LOG=info,tower_http=info
